# Copy this file to `deploy/prod.env` on the server and replace every CHANGE_ME.
# `deploy/prod.env` is gitignored — never commit real secrets.

# --- PostgreSQL (Docker volume: data survives container restarts) ---
POSTGRES_USER=bracket_prod
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=bracket_prod

# Must use hostname `postgres` (Docker service name) and match user/password/db above.
PG_DSN=postgresql://bracket_prod:CHANGE_ME_DB_PASSWORD@postgres:5432/bracket_prod

# --- App secrets (required in production) ---
JWT_SECRET=CHANGE_ME_LONG_RANDOM_HEX_OR_STRING

# --- Public URLs (your real domain or http://SERVER_IP:8400 for testing) ---
BASE_URL=https://your-domain.com
CORS_ORIGINS=https://your-domain.com

# --- Frontend build: same-origin API path (must match API_PREFIX) ---
VITE_API_BASE_URL=/api
API_PREFIX=/api

# Optional: pin image tag when rebuilding
# IMAGE_TAG=v1
